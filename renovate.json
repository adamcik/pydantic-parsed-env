{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>adamcik/renovate-config:library"],
  "nix": {
    "enabled": true
  },
  "labels": ["dependencies"],
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 06:00 on Saturday"]
  },
  "packageRules": [
    {
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "overrideDepName": "uv lock file maintenance",
      "groupName": "uv lock file maintenance",
      "commitMessageTopic": "uv"
    },
    {
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "overrideDepName": "flake lock file maintenance",
      "groupName": "flake lock file maintenance",
      "commitMessageTopic": "flake"
    },
    {
      "matchManagers": ["github-actions", "nix"],
      "matchUpdateTypes": ["digest", "pin", "patch", "minor"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "matchManagers": ["nix"],
      "groupName": "nix flake inputs"
    },
    {
      "matchManagers": ["pep621"],
      "groupName": "python dependencies"
    },
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependencies"],
      "rangeStrategy": "bump"
    },
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups"],
      "rangeStrategy": "bump"
    },
    {
      "matchManagers": ["pep621"],
      "matchDepNames": ["python"],
      "enabled": false
    },
    {
      "description": "Keep the declared minimum fixed for compatibility tests",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups"],
      "matchPackageNames": ["pydantic", "pydantic-settings"],
      "matchJsonata": ["managerData.depGroup = 'compat-minimum'"],
      "enabled": false
    },
    {
      "description": "Track the newest supported 2.x compatibility versions",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups"],
      "matchPackageNames": ["pydantic", "pydantic-settings"],
      "matchJsonata": ["managerData.depGroup = 'compat-latest'"],
      "allowedVersions": "<3",
      "groupName": "latest Pydantic compatibility"
    }
  ]
}
